# API URL for production deployment
# Replace with your Render backend URL after deployment
# Example: VITE_API_URL=https://epiwatch-server.onrender.com
VITE_API_URL=/api

# Google OAuth Client ID (optional)
# To enable Google sign-in:
# 1. Go to https://console.cloud.google.com
# 2. Create a new project or select existing
# 3. Enable Google+ API
# 4. Create OAuth 2.0 Client ID for Web application
# 5. Add your domain to Authorized JavaScript origins (e.g., http://localhost:5173 for dev, https://yourdomain.com for prod)
# 6. Copy the Client ID here
# Example: VITE_GOOGLE_CLIENT_ID=123456789-abcdefghijklmnop.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=
